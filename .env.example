# Thribus Agents — Environment Variables (Frontend)
#
# Defina .env.local na raiz do projeto com estes valores
# para o painel persistir no Supabase ao invés da memória.

# ─── Supabase ────────────────────────────────────────
# Encontre em: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# ─── Worker URL (opcional) ───────────────────────────
# Quando o worker estiver deployed (Railway/Fly.io), aponte aqui
# para o botão "Testar" funcionar com o agent loop real.
# VITE_WORKER_URL=https://thribus-worker.up.railway.app

# ─── Cortex Brain admin (Fase 4) ─────────────────────
# Worker base URL — geralmente o mesmo que VITE_WORKER_URL
VITE_CORTEX_BASE_URL=http://localhost:3200
# Secret pra acessar /cortex/admin/* (mesmo valor de ADMIN_SECRET no worker)
# AVISO: visível no browser. Use só em painel interno protegido.
VITE_CORTEX_ADMIN_SECRET=
