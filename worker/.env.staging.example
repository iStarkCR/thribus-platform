# ══════════════════════════════════════════════════════
# Worker Staging — Environment Variables
# ══════════════════════════════════════════════════════
# Copia esse arquivo no Coolify (env vars da app thribus-worker-staging).
# Substitui os <PLACEHOLDERS> pelos valores reais.
# NÃO commita esse arquivo preenchido.
#
# Estratégia: MESMO projeto Supabase do prod, schema isolado "staging".
# Worker staging usa SUPABASE_SCHEMA=staging — todas as queries vão pra
# staging.* sem tocar nas tabelas de produção.

# ─── Supabase (mesmo projeto da prod, schema staging) ─────────────────────────
# Settings → API do projeto Supabase principal (mesmo que prod usa)
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY_DO_PROJETO>

# CRÍTICO: define o schema isolado pra staging.
# Se omitir, vai bater em PRODUÇÃO. Sempre confira essa linha.
SUPABASE_SCHEMA=staging

# ─── LLM (mesmas keys de prod ou separadas pra tracking) ──────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# ─── CRM (use sandbox / conta de teste — NÃO produção do TexNet!) ─────────────
# Crie uma conta-teste no Talki ou TexNet com 1-2 leads fake pra teste
TEXNET_API_BASE_URL=https://texnet-staging.example.com
TEXNET_API_KEY=<TEXNET_STAGING_TOKEN>
# OU se for usar Talki:
TALKI_BASE_URL=https://talki-staging.example.com
TALKI_API_TOKEN=<TALKI_STAGING_TOKEN>

# ─── Polling (DESLIGADO por default em staging — só liga quando vai testar) ───
POLL_ENABLED=false
POLL_INTERVAL_MS=15000
POLL_PHONE_WHITELIST=

# ─── Concorrência (menor em staging) ──────────────────────────────────────────
MAX_CONCURRENCY=3

# ─── Timeouts ─────────────────────────────────────────────────────────────────
TOOL_TIMEOUT_MS=15000

# ─── Buffer ───────────────────────────────────────────────────────────────────
MESSAGE_BUFFER_MS=5000
MESSAGE_BUFFER_ENABLED=true

# ─── Audio (TTS / Whisper — opcional em staging) ──────────────────────────────
AUDIO_OUT_ENABLED=false
TTS_ENABLED=false

# ─── Sentry / monitoring (opcional) ───────────────────────────────────────────
# SENTRY_DSN=
# LOG_LEVEL=debug
