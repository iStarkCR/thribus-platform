# ══════════════════════════════════════════════════════
# .env.example — PostgREST Coolify deployment
# ══════════════════════════════════════════════════════
# Cole estas vars na seção Environment Variables do Service no Coolify.
# Os valores reais vêm da execução do `generate-jwts.mjs`.
#
# NUNCA comite os valores reais no repo — só o template.
# ══════════════════════════════════════════════════════

# ── Connection ────────────────────────────────────────────────────────────
# Formato: postgresql://authenticator:<senha>@<container-postgres>:5432/<db>
# Exemplos:
#   postgresql://authenticator:SENHA@usicyqipyjfjxap7kgvkw261:5432/thribus_staging
#   postgresql://authenticator:SENHA@<ip-interno>:5432/thribus_staging
# Se o Postgres está no mesmo Coolify, use o nome do container.
PGRST_DB_URI=postgresql://authenticator:CHANGE_ME@usicyqipyjfjxap7kgvkw261:5432/thribus_staging

# ── JWT secret ────────────────────────────────────────────────────────────
# Saída do generate-jwts.mjs item 1. Tem que ser idêntico ao usado pra
# assinar os JWTs do anon e service_role.
PG_JWT_SECRET=CHANGE_ME_32_PLUS_CHARS

# ── (Opcional) Logs detalhados durante setup ────────────────────────────
# PGRST_LOG_LEVEL=info
